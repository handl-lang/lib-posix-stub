--- posix-stub -- deterministic stub backend for the `os` and `fs`
--- ports: path, env, time and filesystem.
---
--- The package's single `posix-stub` module aggregates the port
--- implementations (`path.hnl`, `env.hnl`, `time.hnl`, `fs.hnl`); each
--- arrow is re-exported here so the module record exposes the whole
--- surface.

from "./path" import join as __join
export join := __join
from "./path" import resolve as __resolve
export resolve := __resolve
from "./path" import basename as __basename
export basename := __basename
from "./path" import dirname as __dirname
export dirname := __dirname
from "./path" import extname as __extname
export extname := __extname
from "./env" import get as __get
export get := __get
from "./env" import has as __has
export has := __has
from "./time" import now_ms as __now_ms
export now_ms := __now_ms
from "./time" import instant_ns as __instant_ns
export instant_ns := __instant_ns
from "./time" import elapsed_ns as __elapsed_ns
export elapsed_ns := __elapsed_ns
from "./time" import epoch as __epoch
export epoch := __epoch
from "./time" import now as __now
export now := __now
from "./fs" import read_file as __read_file
export read_file := __read_file
from "./fs" import write_file as __write_file
export write_file := __write_file
from "./fs" import exists as __exists
export exists := __exists
from "./fs" import list_dir as __list_dir
export list_dir := __list_dir
from "./fs" import stat as __stat
export stat := __stat
from "./fs" import lstat as __lstat
export lstat := __lstat
from "./fs" import is_dir as __is_dir
export is_dir := __is_dir
from "./fs" import is_file as __is_file
export is_file := __is_file
from "./fs" import remove as __remove
export remove := __remove
from "./fs" import rmdir as __rmdir
export rmdir := __rmdir
from "./fs" import rename as __rename
export rename := __rename
from "./fs" import mkdir as __mkdir
export mkdir := __mkdir
