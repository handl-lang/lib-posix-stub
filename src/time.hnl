--- Deterministic, no-effect clock stubs (posix contract names).
---
--- @details
--- Covers the `posix` contract's clock surface — `now_ms`,
--- `instant_ns`, `elapsed_ns`, `epoch` — plus the legacy `now`
--- alias. All reads return 0 so tests stay deterministic; the
--- `start` parameter of `elapsed_ns` is ignored, present only for
--- contract compatibility.

--- Always returns 0.
--- @returns {Nat - always 0}
export now_ms: () ~> Nat := () ~> 0

--- Always returns 0.
--- @returns {Nat - always 0}
export instant_ns: () ~> Nat := () ~> 0

--- Always returns 0.
--- @param {start} - ignored; present for contract compatibility
--- @returns {Nat - always 0}
export elapsed_ns: Nat ~> Nat := (start) ~> 0

--- Always returns 0.
--- @returns {Number - always 0}
export epoch: () ~> Number := () ~> 0

--- Always returns 0.
--- @returns {Number - always 0}
export now: () ~> Number := () ~> 0
